{
  "$schema": "../verification/schemas/checks.schema.json",
  "version": 1,
  "checks": [
    {
      "id": "spec-hygiene",
      "argv": [
        "python3",
        "verification/checks/spec_validator.py"
      ],
      "required": true,
      "timeout_seconds": 30,
      "type": "command",
      "description": "Validates markdown links, requirement traceability, and defect schemas"
    },
    {
      "id": "harness-selftests",
      "argv": [
        "python3",
        "verification/checks/test_adapter.py",
        "--discover",
        "verification/selftests"
      ],
      "required": true,
      "timeout_seconds": 60,
      "type": "test_suite",
      "description": "Executes complete verification harness isolated selftest suite via structured test adapter"
    },
    {
      "id": "gradle-wrapper-validation",
      "argv": [
        "python3",
        "verification/checks/gradle_wrapper_check.py"
      ],
      "required": true,
      "timeout_seconds": 30,
      "type": "command",
      "description": "Verifies gradle-wrapper.jar SHA-256 against official Gradle releases checksum and checks wrapper properties"
    },
    {
      "id": "android-lint",
      "argv": [
        "./gradlew",
        "lintDebug",
        "--no-daemon"
      ],
      "required": true,
      "timeout_seconds": 300,
      "type": "command",
      "description": "Executes Android Lint on the offline debug variant and enforces zero errors and zero security regressions"
    },
    {
      "id": "android-unit-tests",
      "argv": [
        "python3",
        "-m",
        "verification.checks.gradle_test_adapter",
        "--task",
        "testDebugUnitTest",
        "--results-dir",
        "app/build/test-results/testDebugUnitTest"
      ],
      "required": true,
      "timeout_seconds": 180,
      "type": "test_suite",
      "description": "Executes JVM unit tests for offline debug variant via Gradle test adapter, enforcing XML freshness and extracting structured JUnit metrics"
    },
    {
      "id": "android-build",
      "argv": [
        "./gradlew",
        "assembleDebug",
        "--no-daemon"
      ],
      "required": true,
      "timeout_seconds": 300,
      "type": "command",
      "description": "Compiles and packages the offline debug APK (:app:assembleDebug)"
    },
    {
      "id": "apk-validation",
      "argv": [
        "python3",
        "verification/checks/apk_validator.py",
        "--connectivity-policy",
        "offline"
      ],
      "required": true,
      "timeout_seconds": 60,
      "type": "command",
      "description": "Verifies offline debug APK existence, SHA-256, INTERNET-free manifest, com.weback.robot identity, signature, and clean-room DEX/native integrity"
    },
    {
      "id": "pilot-android-lint",
      "argv": [
        "./gradlew",
        "lintPilot",
        "--no-daemon"
      ],
      "required": true,
      "timeout_seconds": 300,
      "type": "command",
      "description": "Executes Android Lint on the isolated pilot buildType variant (:app:lintPilot)"
    },
    {
      "id": "pilot-android-unit-tests",
      "argv": [
        "python3",
        "-m",
        "verification.checks.gradle_test_adapter",
        "--task",
        "testPilotUnitTest",
        "--results-dir",
        "app/build/test-results/testPilotUnitTest"
      ],
      "required": true,
      "timeout_seconds": 180,
      "type": "test_suite",
      "description": "Executes JVM unit tests for isolated pilot buildType variant via Gradle test adapter"
    },
    {
      "id": "pilot-android-build",
      "argv": [
        "./gradlew",
        "assemblePilot",
        "--no-daemon"
      ],
      "required": true,
      "timeout_seconds": 300,
      "type": "command",
      "description": "Compiles and packages the isolated pilot APK (:app:assemblePilot)"
    },
    {
      "id": "pilot-apk-validation",
      "argv": [
        "python3",
        "verification/checks/apk_validator.py",
        "--connectivity-policy",
        "pilot"
      ],
      "required": true,
      "timeout_seconds": 60,
      "type": "command",
      "description": "Verifies isolated pilot APK existence, SHA-256, INTERNET-only manifest, com.weback.robot.pilot identity, signature, and clean-room DEX/native integrity"
    },
    {
      "id": "local-android-lint",
      "argv": [
        "./gradlew",
        "lintLocal",
        "--no-daemon"
      ],
      "required": true,
      "timeout_seconds": 300,
      "type": "command",
      "description": "Executes Android Lint on the isolated local buildType variant (:app:lintLocal)"
    },
    {
      "id": "local-android-unit-tests",
      "argv": [
        "python3",
        "-m",
        "verification.checks.gradle_test_adapter",
        "--task",
        "testLocalUnitTest",
        "--results-dir",
        "app/build/test-results/testLocalUnitTest"
      ],
      "required": true,
      "timeout_seconds": 180,
      "type": "test_suite",
      "description": "Executes JVM unit tests for isolated local buildType variant via Gradle test adapter"
    },
    {
      "id": "local-android-build",
      "argv": [
        "./gradlew",
        "assembleLocal",
        "--no-daemon"
      ],
      "required": true,
      "timeout_seconds": 300,
      "type": "command",
      "description": "Compiles and packages the isolated local APK (:app:assembleLocal)"
    },
    {
      "id": "local-apk-validation",
      "argv": [
        "python3",
        "verification/checks/apk_validator.py",
        "--connectivity-policy",
        "local"
      ],
      "required": true,
      "timeout_seconds": 60,
      "type": "command",
      "description": "Verifies isolated local APK existence, SHA-256, INTERNET-only manifest, com.weback.robot.local identity, signature, and clean-room DEX/native integrity"
    }
  ]
}
