{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceReport",
  "description": "Schema for verification evidence report artifacts/verification/<run_id>/report.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "tested_sha",
    "base_sha",
    "policy_sha256",
    "policy_modified_from_base",
    "lane",
    "started_at",
    "finished_at",
    "environment",
    "verdict",
    "checks"
  ],
  "properties": {
    "schema_version": { "type": "integer" },
    "run_id": { "type": "string" },
    "tested_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "policy_modified_from_base": { "type": "boolean" },
    "lane": {
      "type": "string",
      "enum": ["fast", "candidate"]
    },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["python_version", "platform"],
      "properties": {
        "python_version": { "type": "string" },
        "platform": { "type": "string" },
        "os": { "type": "string" }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "ERROR"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "exit_code",
          "duration_seconds",
          "log_file",
          "log_sha256"
        ],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "ERROR", "TIMEOUT"]
          },
          "exit_code": { "type": "integer" },
          "duration_seconds": { "type": "number" },
          "log_file": { "type": "string" },
          "log_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "test_summary": { "type": "object" },
          "cleanup_failed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
